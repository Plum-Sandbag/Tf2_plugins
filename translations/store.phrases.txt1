"Phrases"
{
	"You dont have permission"
	{
		"en" "你没有权限访问此项目."
		"hu" "Nincs jogosultságod ehhez."
	}
	
	"Inventory hasnt been fetched"
	{
		"en" "请稍等，你购买的物品正在处理."
		"hu" "Várj egy kicsit. A tárgyaid még nem töltöttek be."
	}
	
